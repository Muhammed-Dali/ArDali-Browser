{
  "name": "ardali",
  "version": "5.5.2",
  "productName": "ArDali",
  "description": "Open-source Linux media player for music and video with DSP effects, equalizer, and visualizer",
  "main": "main.js",
  "scripts": {
    "pre-release": "node scripts/run-pre-release.js",
    "start": "npm run dev:linux",
    "postinstall": "node scripts/patch-dbus-next-xml2js.js",
    "patch:dbus-next": "node scripts/patch-dbus-next-xml2js.js",
    "dev": "node scripts/dev-platform.js",
    "install:desktop:linux": "bash scripts/install-desktop-linux.sh",
    "gen:icon:transparent": "bash scripts/generate-transparent-icon.sh",
    "gen:win:ico": "node scripts/generate-windows-ico.js",
    "rebuild-native": "npm --prefix native ci && npm --prefix native run rebuild",
    "verify:libs": "node native/verify-libs.js",
    "verify:binary:manifest": "node scripts/verify-binary-manifest.js",
    "verify:release:metadata": "node scripts/verify-release-metadata.js",
    "verify:release:docs": "node scripts/verify-release-docs.js",
    "release:checksums": "node scripts/generate-release-checksums.js dist",
    "prepare:win:resources": "node scripts/prepare-win-resources.js",
    "locale:coverage": "node scripts/generate-locale-coverage.js",
    "locale:sync": "node scripts/sync-locales.js",
    "locale:sync:shortcuts": "node scripts/sync-locales.js --group shortcuts",
    "icons:unused": "node scripts/check-unused-icons.js",
    "verify:i18n": "node --check modules/i18n.js && node --check renderer.js && node --check scripts/generate-locale-coverage.js && node --check scripts/verify-i18n.js && node scripts/verify-i18n.js && npm run -s locale:coverage",
    "build": "node native/copy-libs.js && npm run -s patch:dbus-next && electron-builder",
    "rebuild:electron:linux": "if [ -d node_modules/usocket ]; then (cd node_modules/usocket && npx node-gyp rebuild --target=43.2.0 --dist-url=https://electronjs.org/headers --arch=x64); else echo \"[rebuild:electron:linux] usocket not present; skipping native rebuild\"; fi",
    "build:linux": "node native/copy-libs.js linux && node scripts/verify-linux-artifacts.js && npm run -s rebuild:electron:linux && npm run -s patch:dbus-next && electron-builder --linux -c.npmRebuild=false",
    "build:linux:appimage": "node native/copy-libs.js linux && node scripts/verify-linux-artifacts.js && npm run -s rebuild:electron:linux && npm run -s patch:dbus-next && electron-builder --linux AppImage -c.npmRebuild=false",
    "verify:win:artifacts": "node scripts/verify-win-artifacts.js",
    "build:win": "node native/copy-libs.js win32 && npm run -s prepare:win:resources && npm run -s verify:win:artifacts && electron-builder --win",
    "build:win:publish": "node native/copy-libs.js win32 && npm run -s prepare:win:resources && npm run -s verify:win:artifacts && electron-builder --win --publish=always",
    "build:win:zip": "node native/copy-libs.js win32 && npm run -s prepare:win:resources && npm run -s verify:win:artifacts && electron-builder --win zip",
    "build:mac": "node native/copy-libs.js darwin && electron-builder --mac",
    "dist": "npm run build:linux",
    "dev:linux": "ELECTRON_RUN_AS_NODE= ARDALI_DEV=1 PATH=\"$(pwd)/native/build/Release:$(pwd)/native-dist:$(pwd)/native-dist/linux:$(pwd)/libs/linux:$(pwd)/bin:$PATH\" LD_LIBRARY_PATH=\"$(pwd)/native/build/Release:$(pwd)/native-dist:$(pwd)/native-dist/linux:$(pwd)/libs/linux:${LD_LIBRARY_PATH:-}\" electron --enable-logging --disable-vulkan --disable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE .",
    "dali:compile:web": "node scripts/compile-dali-web.js",
    "dali:compile:web:wasm": "node scripts/compile-dali-web-wasm.js",
    "dali:compile:web:all": "npm run -s dali:compile:web && npm run -s dali:compile:web:wasm",
    "dali:test:regression": "node scripts/dali-web-regression.js",
    "dali:test:regression:update": "node scripts/dali-web-regression.js --update",
    "dali:test:security": "node scripts/dali-security-suite.js",
    "test:credential-vault": "node scripts/test-credential-vault.js",
    "test:electron-security": "node scripts/test-electron-security.js",
    "test:audio-effects-startup": "node scripts/test-audio-effects-startup.js",
    "test:projectm-window": "node scripts/test-projectm-window-integration.js",
    "test:tab-architecture": "node scripts/test-tab-architecture.js",
    "dali:test:wasm": "npm run -s dali:compile:web:wasm && node scripts/dali-wasm-smoke.js",
    "dali:test:parity": "node scripts/dali-ir-parity.js",
    "dali:test:fuzz": "node scripts/dali-fuzz.js",
    "dali:test:perf": "node scripts/dali-perf-benchmark.js",
    "native:audio:smoke": "node scripts/native-audio-smoke.js",
    "dali:test:all": "npm run -s dali:compile:web:all && npm run -s dali:test:regression && npm run -s dali:test:security && npm run -s dali:test:wasm && npm run -s dali:test:parity && npm run -s dali:test:fuzz && npm run -s dali:test:perf",
    "dali:install:filetype:linux": "bash scripts/install-dali-filetype-linux.sh",
    "dev:win": "cmd /c \"chcp 65001>nul && set ELECTRON_RUN_AS_NODE=&& set ARDALI_DEV=1&& set PATH=C:\\msys64\\mingw64\\bin;C:\\Users\\muhan\\Desktop\\ArDali-Medya-Player-windows\\native-dist\\windows;C:\\Users\\muhan\\Desktop\\ArDali-Medya-Player-windows\\native-dist;C:\\Users\\muhan\\Desktop\\ArDali-Medya-Player-windows\\native\\build\\Release;C:\\Users\\muhan\\Desktop\\ArDali-Medya-Player-windows\\bin;%PATH%&& electron . --enable-logging\"",
    "locale:sync:visualizer": "node scripts/sync-visualizer-native-locales.js",
    "locale:sync:main": "node scripts/sync-main-process-locales.js"
  },
  "author": "Muhammet Dali",
  "keywords": [
    "linux",
    "media-player",
    "music-player",
    "video-player",
    "electron",
    "appimage",
    "deb",
    "rpm",
    "equalizer",
    "dsp",
    "visualizer",
    "audio-effects"
  ],
  "homepage": "https://ardali.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammed-Dali/ArDali-WebMedia.git"
  },
  "packageManager": "npm@10.9.0",
  "license": "GPL-3.0-only",
  "build": {
    "appId": "com.ardali.mediaplayer",
    "productName": "ArDali",
    "electronVersion": "43.2.0",
    "icon": "icons/app/ardali.ico",
    "artifactName": "ArDali-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build-resources"
    },
    "publish": {
      "provider": "github",
      "owner": "Muhammed-Dali",
      "repo": "ArDali-WebMedia",
      "private": false
    },
    "protocols": [
      {
        "name": "ArDali Media Player",
        "schemes": [
          "ardali"
        ]
      },
      {
        "name": "ArDali Web Browser",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "mp3"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "wav"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "flac"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "aac"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "ogg"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "m4a"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "opus"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "aiff"
      },
      {
        "name": "ArDali Audio",
        "description": "ArDali Media Player Audio",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "wma"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "mp4"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "mkv"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "avi"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "mov"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "wmv"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "webm"
      },
      {
        "name": "ArDali Video",
        "description": "ArDali Media Player Video",
        "role": "Viewer",
        "icon": "icons/app/ardali.ico",
        "ext": "m4v"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib"
    ],
    "files": [
      "**/*",
      "!.git/**",
      "!.cache/**",
      "!**/.cache/**",
      "!**/*.md",
      "!**/.vscode/**",
      "!**/__pycache__/**",
      "!**/*.ipynb",
      "!**/*.AppImage",
      "!**/*.pkg.tar.zst",
      "!ardali-bin/**",
      "!packaging/**",
      "!bin/ffmpeg.exe",
      "!dist/**",
      "!build/**",
      "!build-native-cmake/**",
      "!build-flatpak/**",
      "!flatpak-build/**",
      "!build-visualizer/**",
      "!.flatpak-builder/**",
      "!repo/**",
      "!screenshots/**",
      "!venv/**",
      "!.venv/**",
      "!**/venv/**",
      "!**/.venv/**",
      "!native/node_modules/**",
      "!native-dist/**",
      "!native/build/Release/obj.target/**",
      "!native/build/Release/.deps/**",
      "!native/**/*.o",
      "!native/**/*.a",
      "!libs/**",
      "native/build/Release/*.node",
      "native/build/Release/*.so",
      "native/build/Release/*.dll",
      "native/build/Release/*.dylib"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "ArDali <support@ardali.app>",
      "category": "Network",
      "executableName": "ardali",
      "desktop": {
        "entry": {
          "Name": "ArDali",
          "Comment": "Media player and privacy-focused web browser",
          "Categories": "AudioVideo;Player;Network;WebBrowser;",
          "Keywords": "Music;Audio;Video;Media;Player;Browser;Web;Linux;AppImage;Deb;Rpm;Equalizer;DSP;ArDali;",
          "MimeType": "x-scheme-handler/http;x-scheme-handler/https;"
        }
      },
      "icon": "icons/app/ardali_512.png",
      "extraResources": [
        {
          "from": "/usr/bin/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "native/build/Release",
          "to": "native/build/Release",
          "filter": [
            "**/*.node",
            "**/*.so"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "native/build/Release",
          "to": "resources/native/build/Release",
          "filter": [
            "*.so",
            "*.node"
          ]
        },
        {
          "from": "native-dist/linux",
          "to": "resources/native-dist/linux",
          "filter": [
            "ardali-projectm-visualizer",
            "libprojectM-4.so*",
            "libprojectM-4-playlist.so*"
          ]
        },
        {
          "from": "third_party/projectm/presets",
          "to": "resources/third_party/projectm/presets"
        },
        {
          "from": "icons/app/ardali_alt_boldA_transparent_1024.png",
          "to": "resources/icons/app/ardali_alt_boldA_transparent_1024.png"
        },
        {
          "from": "icons/app/ardali_logo.bmp",
          "to": "resources/icons/app/ardali_logo.bmp"
        },
        {
          "from": "packaging/appstream/com.ardali.mediaplayer.metainfo.xml",
          "to": "usr/share/metainfo/com.ardali.mediaplayer.metainfo.xml"
        }
      ]
    },
    "win": {
      "signtoolOptions": {
        "publisherName": [
          "Muhammet Dali"
        ]
      },
      "target": [
        "nsis"
      ],
      "icon": "icons/app/ardali.ico",
      "executableName": "ArDali",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        },
        {
          "from": "native-dist/windows",
          "to": "native-dist/windows",
          "filter": [
            "ardali-projectm-visualizer.exe",
            "*.dll"
          ]
        },
        {
          "from": "native/build/Release",
          "to": "native/build/Release",
          "filter": [
            "**/*.node",
            "**/*.dll"
          ]
        },
        {
          "from": "icons/app/ardali.ico",
          "to": "icons/app/ardali.ico"
        },
        {
          "from": "icons/app/ardali_256.png",
          "to": "icons/app/ardali_256.png"
        },
        {
          "from": "icons/app/ardali_512.png",
          "to": "icons/app/ardali_512.png"
        },
        {
          "from": "icons/app/ardali_logo.bmp",
          "to": "icons/app/ardali_logo.bmp"
        },
        {
          "from": "third_party/projectm/presets",
          "to": "visualizer-presets",
          "filter": [
            "*.zip",
            "*.milk"
          ]
        },
        {
          "from": "libs/windows",
          "to": "native/build/Release",
          "filter": [
            "*.dll"
          ]
        }
      ]
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "extraFiles": [
        {
          "from": "native/build/Release",
          "to": "resources/native/build/Release",
          "filter": [
            "*.dylib",
            "*.node"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "tr_TR",
        "en_US",
        "ar_SA"
      ],
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ArDali",
      "installerIcon": "icons/app/ardali.ico",
      "uninstallerIcon": "icons/app/ardali.ico",
      "installerHeaderIcon": "icons/app/ardali.ico"
    }
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "png-to-ico": "3.0.2"
  },
  "dependencies": {
    "dompurify": "3.4.13",
    "electron-updater": "6.8.9",
    "mpris-service": "^2.1.2",
    "node-id3": "0.2.9",
    "systeminformation": "5.33.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "dbus-next": "0.10.2",
    "tar": "7.5.22",
    "usocket": "1.1.0",
    "xml2js": "0.6.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "usocket@1.1.0": true
  }
}
