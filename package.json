{
  "name": "aurivo-media-player",
  "version": "2.0.56",
  "description": "Open-source Linux media player for music and video with DSP effects, equalizer, visualizer, downloader, and song recognition",
  "main": "main.js",
  "scripts": {
    "start": "npm run dev:linux",
    "dev": "node scripts/dev-platform.js",
    "install:desktop:linux": "bash scripts/install-desktop-linux.sh",
    "gen:icon:transparent": "bash scripts/generate-transparent-icon.sh",
    "gen:win:ico": "node scripts/generate-windows-ico.js",
    "rebuild-native": "npm --prefix native ci && npm --prefix native run rebuild",
    "verify:libs": "node native/verify-libs.js",
    "verify:binary:manifest": "node scripts/verify-binary-manifest.js",
    "release:checksums": "node scripts/generate-release-checksums.js dist",
    "prepare:win:resources": "node scripts/prepare-win-resources.js",
    "locale:coverage": "node scripts/generate-locale-coverage.js",
    "locale:sync": "node scripts/sync-locales.js",
    "locale:sync:shortcuts": "node scripts/sync-locales.js --group shortcuts",
    "icons:unused": "node scripts/check-unused-icons.js",
    "verify:i18n": "node --check modules/i18n.js && node --check renderer.js && node --check scripts/generate-locale-coverage.js && node --check scripts/verify-i18n.js && node scripts/verify-i18n.js && npm run -s locale:coverage",
    "build": "node native/copy-libs.js && electron-builder",
    "rebuild:electron:linux": "if [ -d node_modules/abstract-socket ]; then (cd node_modules/abstract-socket && npx node-gyp rebuild --target=40.6.1 --dist-url=https://electronjs.org/headers --arch=x64); else echo \"[rebuild:electron:linux] abstract-socket not present; skipping native rebuild\"; fi",
    "build:linux": "node native/copy-libs.js linux && node scripts/verify-linux-artifacts.js && npm run -s rebuild:electron:linux && electron-builder --linux -c.npmRebuild=false",
    "build:linux:appimage": "node native/copy-libs.js linux && node scripts/verify-linux-artifacts.js && npm run -s rebuild:electron:linux && electron-builder --linux AppImage -c.npmRebuild=false",
    "verify:win:artifacts": "node scripts/verify-win-artifacts.js",
    "build:win": "node native/copy-libs.js win32 && npm run -s prepare:win:resources && npm run -s verify:win:artifacts && electron-builder --win",
    "build:win:publish": "node native/copy-libs.js win32 && npm run -s prepare:win:resources && npm run -s verify:win:artifacts && electron-builder --win --publish=always",
    "build:win:zip": "node native/copy-libs.js win32 && npm run -s prepare:win:resources && npm run -s verify:win:artifacts && electron-builder --win zip",
    "build:mac": "node native/copy-libs.js darwin && electron-builder --mac",
    "dist": "npm run build:linux",
    "dev:linux": "ELECTRON_RUN_AS_NODE= AURIVO_DEV=1 PATH=\"$(pwd)/native-dist:$(pwd)/native/build/Release:$(pwd)/bin:$PATH\" electron . --enable-logging",
    "profile:linux": "ELECTRON_RUN_AS_NODE= AURIVO_DEV=1 AURIVO_PERF_MONITOR=1 PATH=\"$(pwd)/native-dist:$(pwd)/native/build/Release:$(pwd)/bin:$PATH\" electron . --enable-logging",
    "dali:compile:web": "node scripts/compile-dali-web.js",
    "dali:compile:web:wasm": "node scripts/compile-dali-web-wasm.js",
    "dali:compile:web:all": "npm run -s dali:compile:web && npm run -s dali:compile:web:wasm",
    "dali:test:regression": "node scripts/dali-web-regression.js",
    "dali:test:regression:update": "node scripts/dali-web-regression.js --update",
    "dali:test:security": "node scripts/dali-security-suite.js",
    "dali:test:wasm": "npm run -s dali:compile:web:wasm && node scripts/dali-wasm-smoke.js",
    "dali:test:parity": "node scripts/dali-ir-parity.js",
    "dali:test:fuzz": "node scripts/dali-fuzz.js",
    "dali:test:perf": "node scripts/dali-perf-benchmark.js",
    "native:audio:smoke": "node scripts/native-audio-smoke.js",
    "dali:test:all": "npm run -s dali:compile:web:all && npm run -s dali:test:regression && npm run -s dali:test:security && npm run -s dali:test:wasm && npm run -s dali:test:parity && npm run -s dali:test:fuzz && npm run -s dali:test:perf",
    "dali:install:filetype:linux": "bash scripts/install-dali-filetype-linux.sh",
    "profile:linux:dali": "npm run -s dali:compile:web && npm run -s profile:linux",
    "dev:win": "cmd /c \"chcp 65001>nul && set ELECTRON_RUN_AS_NODE=&& set AURIVO_DEV=1&& set PATH=C:\\msys64\\mingw64\\bin;C:\\Users\\muhan\\Desktop\\Aurivo-Medya-Player-windows\\native-dist\\windows;C:\\Users\\muhan\\Desktop\\Aurivo-Medya-Player-windows\\native-dist;C:\\Users\\muhan\\Desktop\\Aurivo-Medya-Player-windows\\native\\build\\Release;C:\\Users\\muhan\\Desktop\\Aurivo-Medya-Player-windows\\bin;%PATH%&& electron . --enable-logging\"",
    "adblock:build": "node uDALİ-weman-home/scripts/buildBlocklist.cjs",
    "adblock:sync": "node uDALİ-weman-home/scripts/syncBlocklistToApp.cjs",
    "adblock:rebuild": "npm run -s adblock:build && npm run -s adblock:sync",
    "locale:sync:visualizer": "node scripts/sync-visualizer-native-locales.js",
    "locale:sync:main": "node scripts/sync-main-process-locales.js"
  },
  "author": "Muhammet Dali",
  "keywords": [
    "linux",
    "media-player",
    "music-player",
    "video-player",
    "electron",
    "appimage",
    "deb",
    "rpm",
    "equalizer",
    "dsp",
    "visualizer",
    "audio-effects"
  ],
  "homepage": "https://aurivo.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammed-aurivo-dev/Aurivo-Medya-Player-Linux.git"
  },
  "packageManager": "bun@1.1.0",
  "license": "MIT",
  "build": {
    "appId": "com.aurivo.mediaplayer",
    "productName": "Aurivo Media Player",
    "electronVersion": "40.6.1",
    "icon": "icons/aurivo.ico",
    "artifactName": "Aurivo-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build-resources"
    },
    "publish": {
      "provider": "github",
      "owner": "muhammed-aurivo-dev",
      "repo": "Aurivo-Medya-Player-Linux",
      "private": false
    },
    "protocols": [
      {
        "name": "Aurivo Media Player",
        "schemes": [
          "aurivo"
        ]
      }
    ],
    "fileAssociations": [
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "mp3"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "wav"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "flac"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "aac"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "ogg"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "m4a"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "opus"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "aiff"
      },
      {
        "name": "Aurivo Audio",
        "description": "Aurivo Media Player Audio",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "wma"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "mp4"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "mkv"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "avi"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "mov"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "wmv"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "webm"
      },
      {
        "name": "Aurivo Video",
        "description": "Aurivo Media Player Video",
        "role": "Viewer",
        "icon": "icons/aurivo.ico",
        "ext": "m4v"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib",
      "uDALİ-weman-home/chromium/**"
    ],
    "files": [
      "**/*",
      "!.git/**",
      "!.cache/**",
      "!**/.cache/**",
      "!**/*.md",
      "!**/.vscode/**",
      "!**/__pycache__/**",
      "!**/*.ipynb",
      "!**/*.AppImage",
      "!**/*.pkg.tar.zst",
      "!aurivo-bin/**",
      "!packaging/**",
      "!Aurivo-Pulse/target/**",
      "!bin/ffmpeg.exe",
      "!dist/**",
      "!build/**",
      "!build-flatpak/**",
      "!flatpak-build/**",
      "!build-visualizer/**",
      "!.flatpak-builder/**",
      "!repo/**",
      "!screenshots/**",
      "!venv/**",
      "!.venv/**",
      "!**/venv/**",
      "!**/.venv/**",
      "!native/node_modules/**",
      "!native-dist/**",
      "!native/build/Release/obj.target/**",
      "!native/build/Release/.deps/**",
      "!native/**/*.o",
      "!native/**/*.a",
      "!libs/**",
      "native/build/Release/*.node",
      "native/build/Release/*.so",
      "native/build/Release/*.dll",
      "native/build/Release/*.dylib"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "Aurivo <support@aurivo.app>",
      "category": "AudioVideo",
      "executableName": "aurivo",
      "desktop": {
        "entry": {
          "Name": "Aurivo Media Player",
          "Comment": "Open-source Linux media player for music and video",
          "Categories": "AudioVideo;Player;",
          "Keywords": "Music;Audio;Video;Media;Player;Linux;AppImage;Deb;Rpm;Equalizer;DSP;Aurivo;"
        }
      },
      "icon": "icons/aurivo_512.png",
      "extraResources": [
        {
          "from": "/usr/bin/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "uDALİ-weman-home/chromium",
          "to": "uDALİ-weman-home/chromium"
        },
        {
          "from": "native/build/Release",
          "to": "native/build/Release",
          "filter": [
            "**/*.node",
            "**/*.so"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "native/build/Release",
          "to": "resources/native/build/Release",
          "filter": [
            "*.so",
            "*.node"
          ]
        },
        {
          "from": "native-dist/linux",
          "to": "resources/native-dist/linux",
          "filter": [
            "aurivo-pulse",
            "aurivo-projectm-visualizer",
            "libprojectM-4.so*",
            "libprojectM-4-playlist.so*"
          ]
        },
        {
          "from": "third_party/projectm/presets",
          "to": "resources/third_party/projectm/presets"
        },
        {
          "from": "icons/aurivo_alt_boldA_transparent_1024.png",
          "to": "resources/icons/aurivo_alt_boldA_transparent_1024.png"
        },
        {
          "from": "icons/aurivo_logo.bmp",
          "to": "resources/icons/aurivo_logo.bmp"
        },
        {
          "from": "packaging/appstream/com.aurivo.mediaplayer.metainfo.xml",
          "to": "usr/share/metainfo/com.aurivo.mediaplayer.metainfo.xml"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/aurivo.ico",
      "executableName": "Aurivo",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        },
        {
          "from": "native-dist/windows",
          "to": "native-dist/windows",
          "filter": [
            "aurivo-projectm-visualizer.exe",
            "*.dll"
          ]
        },
        {
          "from": "native/build/Release",
          "to": "native/build/Release",
          "filter": [
            "**/*.node",
            "**/*.dll"
          ]
        },
        {
          "from": "icons/aurivo.ico",
          "to": "icons/aurivo.ico"
        },
        {
          "from": "icons/aurivo_256.png",
          "to": "icons/aurivo_256.png"
        },
        {
          "from": "icons/aurivo_512.png",
          "to": "icons/aurivo_512.png"
        },
        {
          "from": "icons/aurivo_logo.bmp",
          "to": "icons/aurivo_logo.bmp"
        },
        {
          "from": "third_party/projectm/presets",
          "to": "visualizer-presets",
          "filter": [
            "*.zip",
            "*.milk"
          ]
        },
        {
          "from": "libs/windows",
          "to": "native/build/Release",
          "filter": [
            "*.dll"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "extraFiles": [
        {
          "from": "native/build/Release",
          "to": "resources/native/build/Release",
          "filter": [
            "*.dylib",
            "*.node"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "tr_TR",
        "en_US",
        "ar_SA"
      ],
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurivo",
      "installerIcon": "icons/aurivo.ico",
      "uninstallerIcon": "icons/aurivo.ico",
      "installerHeaderIcon": "icons/aurivo.ico"
    }
  },
  "devDependencies": {
    "electron": "41.2.0",
    "electron-builder": "26.8.1",
    "png-to-ico": "3.0.1"
  },
  "dependencies": {
    "electron-updater": "6.7.3",
    "mpris-service": "^2.1.2",
    "node-id3": "0.2.9",
    "systeminformation": "5.31.5",
    "yt-dlp-wrap-plus": "2.4.3"
  }
}
