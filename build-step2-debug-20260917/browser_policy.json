{
  "version": 1,
  "name": "ArDaliBrowser",
  "engine": "chromium",
  "embedder": "qt_webengine",
  "capabilities": {
    "allow": [
      "window.create",
      "window.reparent_live_page",
      "navigation.http_https",
      "downloads.prompt",
      "session.restore"
    ],
    "deny": [
      "filesystem.unscoped",
      "process.spawn",
      "popup.unrequested"
    ]
  },
  "tabs": {
    "ownership": "single_live_page",
    "detach": "preserve_context",
    "attach": "preserve_context",
    "tab_strip": "native_pointer"
  },
  "platforms": {
    "wayland": {
      "attach": "require_verified_global_coordinates"
    }
  }
}
