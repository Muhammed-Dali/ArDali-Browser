# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0

# Snyk Code suppressions (SAST)
# These are known-and-accepted findings where the risk is mitigated by design.
ignore:
  # ElectronInsecureWebPreferences — sandbox: false required for preload.js
  #
  # Context: Aurivo uses contextBridge + contextIsolation: true throughout.
  # The preload.js scripts use require('electron') and other Node.js built-ins
  # to expose a limited, strongly-typed IPC bridge to the renderer via
  # contextBridge.exposeInMainWorld(). Electron requires sandbox: false when
  # a preload script accesses Node.js APIs.
  #
  # Mitigations in place:
  #   - contextIsolation: true  (renderer cannot access Node.js globals)
  #   - nodeIntegration: false  (renderer has no direct Node.js access)
  #   - webSecurity: true
  #   - allowRunningInsecureContent: false
  #   - will-attach-webview forces sandbox: true + deletes preload on all webviews
  #   - setWindowOpenHandler blocks arbitrary popups
  #   - setPermissionRequestHandler denies sensitive permissions
  #   - All IPC channels validate sender identity
  'javascript/ElectronInsecureWebPreferences':
    - main.js:
        reason: >
          sandbox: false is required for preload.js (uses require()). Mitigated by
          contextIsolation: true, nodeIntegration: false, webSecurity: true, and
          a strict contextBridge-only API surface. Webviews keep sandbox: true.
        expires: '2027-01-01T00:00:00.000Z'
        created: '2026-04-18T20:00:00.000Z'
    - Aurivo-Dawlod/main.js:
        reason: >
          Aurivo-Dawlod preload.js uses Node.js require() for a restricted bridge.
          Mitigated by contextIsolation: true, nodeIntegration: false, webSecurity: true,
          allowRunningInsecureContent: false, and controlled IPC handlers.
        expires: '2027-01-01T00:00:00.000Z'
        created: '2026-04-18T20:00:00.000Z'
    - modules/dawlodHost.js:
        reason: >
          Dawlod preload.js requires require() for electron IPC and Node.js built-ins.
          Mitigated by contextIsolation: true, nodeIntegration: false, and a path-
          traversal-safe aurivoRequire() wrapper that only allows known modules.
        expires: '2027-01-01T00:00:00.000Z'
        created: '2026-04-18T20:00:00.000Z'

patch: {}
