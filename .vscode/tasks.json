{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ArDali: Build Browser",
      "type": "shell",
      "command": "cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -B build -S . && cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ArDali: Run Browser",
      "type": "shell",
      "command": "./build/ardali-browser",
      "dependsOn": ["ArDali: Build Browser"],
      "problemMatcher": []
    },
    {
      "label": "DALI: Run Security Suite",
      "type": "shell",
      "command": "node dali-lang/scripts/dali-security-suite.js",
      "problemMatcher": []
    }
  ]
}
